{
  "name": "elevator",
  "scripts": {
    "test": "node --env-file=.env ./node_modules/.bin/playwright test",
    "dev": "npm run development",
    "ui:build": "(cd assets/elevator-ui && yarn build)",
    "ui:build:watch": "(cd assets/elevator-ui && yarn build:watch)",
    "gulp": "gulp",
    "test:api": "node --env-file=.env node_modules/.bin/playwright test",
    "test:api:ui": "node --env-file=.env node_modules/.bin/playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.19.13",
    "dotenv": "^17.3.1"
  },
  "dependencies": {
    "del": "^8.0.0",
    "gulp": "^5.0.0",
    "gulp-changed": "^5.0.2",
    "gulp-cli": "^3.0.0",
    "gulp-concat": "^2.6.1",
    "gulp-rename": "^2.0.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-uglify": "^3.0.2",
    "gulp-uglifycss": "^1.1.0"
  }
}
